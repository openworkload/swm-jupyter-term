#!/bin/bash
#
# This is a job script that is executed by Sky Port on a compute node.
# The script is used to start JupyterHub user server.

#SWM relocatable
#SWM flavor {{ job_info["flavor"] | swm_token }}
#SWM ports {{ job_info["ports"] }}
#SWM account {{ job_info["account"] }}
#SWM cloud-image {{ job_info["cloud_image_name"] | swm_token }}
#SWM container-image {{ job_info["container_registry"] }}/{{ job_info["container_image_name"] }}:{{ job_info["container_image_tag"] }}
#SWM input-files {{ " ".join(job_info["input_files"]) }}
#SWM output-files {{ " ".join(job_info["output_files"]) }}
#SWM storage {{ job_info["storage"] }}
#SWM gpus {{ job_info["gpus"] | swm_token }}

export HOME=$(pwd)
export XDG_CACHE_HOME=${HOME}/.cache/
TOKEN_FILE=jupyterhub_api_token
if [ ! -f "$TOKEN_FILE" ]; then
  echo "Missing $TOKEN_FILE (expected via #SWM input-files)" >&2
  exit 1
fi
export JUPYTERHUB_API_TOKEN=$(cat "$TOKEN_FILE")
rm -f "$TOKEN_FILE"
export JUPYTERHUB_CLIENT_ID={{ job_info["jupyterhub_client_id"] }}
export JUPYTERHUB_API_URL={{ job_info["hub_url"] }}
export JUPYTER_RUNTIME_DIR=/tmp
export JUPYTERHUB_USER=$USER
export JUPYTERHUB_SERVICE_PREFIX=/user/$USER
export JUPYTERHUB_SERVICE_URL={{ job_info["service_scheme"] }}://0.0.0.0:{{ job_info["server_port"] }}
{% if job_info["internal_ssl"] %}
SSL_KEY_FILE={{ job_info["ssl_key_file"] }}
SSL_CERT_FILE={{ job_info["ssl_cert_file"] }}
SSL_CA_FILE={{ job_info["ssl_ca_file"] }}
for ssl_file in "$SSL_KEY_FILE" "$SSL_CERT_FILE" "$SSL_CA_FILE"; do
  if [ ! -f "$ssl_file" ]; then
    echo "Missing $ssl_file (expected via #SWM input-files for internal SSL)" >&2
    exit 1
  fi
done
export JUPYTERHUB_SSL_KEYFILE="$SSL_KEY_FILE"
export JUPYTERHUB_SSL_CERTFILE="$SSL_CERT_FILE"
export JUPYTERHUB_SSL_CLIENT_CA="$SSL_CA_FILE"
{% endif %}
export JUPYTERHUB_OAUTH_ACCESS_SCOPES="[\"access:servers!server=$USER/\", \"access:servers!user=$USER\"]"
export NVIDIA_VISIBLE_DEVICES=all

echo Start single user jupyter server
jupyterhub-singleuser --debug
